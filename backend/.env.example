DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Neon only: direct (unpooled) connection used by `prisma migrate deploy`.
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
JWT_SECRET="ganti-dengan-random-32-karakter"
CORS_ORIGIN="https://domain-frontend.vercel.app"
# Set only behind a trusted reverse proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1
PORT=4000
ADMIN_EMAIL="admin@domain.com"
ADMIN_PASSWORD="ganti-password-kuat"
